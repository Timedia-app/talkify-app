rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isStaff() { return signedIn() && (role() == 'admin' || role() == 'assistant'); }
    function emailIs(e) { return signedIn() && request.auth.token.email == e; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // premier login : chaque compte crée sa fiche, avec le rôle fixé par son email
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && (
        (emailIs('admin@talkify.app') && request.resource.data.role == 'admin') ||
        (emailIs('classe@talkify.app') && request.resource.data.role == 'assistant')));
      // chacun peut ajouter ses jetons de notification ; le rôle ne change pas
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /{col}/{id} {
      allow read, write: if isStaff() && col in ['groups', 'students', 'payments', 'prospects', 'attendance', 'contacts'];
    }
    match /expenses/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    // journal d'activité : la responsable écrit, seul l'admin lit
    match /events/{id} { allow create: if isStaff(); allow read, delete: if isAdmin(); }
  }
}
